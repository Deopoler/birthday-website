#!/bin/sh
# 공개 저장소 보호: 허용 목록(scripts/allowed-images.txt)에 없는 이미지가 커밋에 들어가면 막는다.
# fail-closed: 검사를 실행할 수 없으면(git/node 없음, 스크립트 오류) 커밋을 막는다.
# (긴급히 우회해도 GitHub Actions 와 npm run build 가 같은 검사를 다시 한다.)

root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$root" ] || ! cd "$root"; then
  echo "[사진 보호] 저장소 위치를 알 수 없어 커밋을 막았어요." >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "[사진 보호] node 를 찾을 수 없어 사진 검사를 할 수 없어요. 안전을 위해 커밋을 막았어요." >&2
  echo "  → Node.js 를 설치하거나(https://nodejs.org), node 가 보이는 터미널에서 다시 커밋하세요." >&2
  exit 1
fi

node scripts/check-no-photos.mjs --staged
status=$?
if [ "$status" -ne 0 ]; then
  exit 1
fi
exit 0
